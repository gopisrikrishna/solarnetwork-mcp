{
  "name": "solarnetwork-mcp",
  "version": "0.3.0",
  "description": "MCP server for solar asset management: reads SolarNetwork telemetry, finds dated equipment faults, and writes field-ready service reports as PDFs.",
  "type": "module",
  "bin": {
    "solarnetwork-mcp": "dist/index.js"
  },
  "scripts": {
    "prepare": "tsc",
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "verify": "node scripts/verify.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "mysql2": "^3.24.2",
    "pdfkit": "^0.20.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "typescript": "^5.6.0"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "USAGE.md",
    "DATA.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "solar",
    "solarnetwork",
    "pv",
    "asset-management",
    "telemetry",
    "ecosuite"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gopisrikrishna/solarnetwork-mcp.git"
  }
}
